{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iasa.local/schemas/hybrid-rag-groundedness-review-v2.json",
  "title": "Hybrid RAG Groundedness Human Review v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "provenance", "reviews"],
  "properties": {
    "protocol_version": {"const": "hybrid-rag-groundedness-review-v2"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "answers_sha256",
        "source_review_sha256",
        "source_review_file",
        "original_provenance_checkpoint"
      ],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "answers_sha256": {"$ref": "#/$defs/sha256"},
        "source_review_sha256": {"$ref": "#/$defs/sha256"},
        "source_review_file": {"type": "string", "minLength": 1},
        "original_provenance_checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "expected_sha256", "role"],
          "properties": {
            "status": {"const": "unavailable"},
            "expected_sha256": {"$ref": "#/$defs/sha256"},
            "role": {"const": "provenance_checkpoint_not_runtime_input"}
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/review"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "support": {
      "enum": ["supported", "partial", "unsupported", "uncertain", "unassessed"]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "disposition",
        "supporting_source_ids",
        "model_cited_source_ids",
        "relevant_cited_source_ids"
      ],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 1500},
        "disposition": {"enum": ["supported", "unsupported", "uncertain"]},
        "supporting_source_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "model_cited_source_ids": {
          "description": "Record exactly what the model cited, including IDs absent from retrieved sources.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "relevant_cited_source_ids": {
          "description": "Only model-cited IDs that the reviewer confirms support this claim.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "supported"}}, "required": ["disposition"]},
          "then": {"properties": {"supporting_source_ids": {"minItems": 1}}}
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "answer_sha256",
        "reviewer",
        "review_status",
        "reviewer_notes",
        "manifest_expected_abstention_appropriate",
        "actual_answer_abstained",
        "reviewer_assessed_abstention_appropriate",
        "retrieval_found_relevant_evidence",
        "raw_response_status",
        "raw_response_sha256",
        "raw_response_overall_support",
        "raw_claims",
        "final_response_overall_support",
        "final_claims"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "answer_sha256": {"$ref": "#/$defs/sha256"},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 255},
        "review_status": {"enum": ["pending", "reviewed"]},
        "reviewer_notes": {"type": "string", "minLength": 1, "maxLength": 2000},
        "manifest_expected_abstention_appropriate": {"type": "boolean"},
        "actual_answer_abstained": {"type": "boolean"},
        "reviewer_assessed_abstention_appropriate": {"type": "boolean"},
        "retrieval_found_relevant_evidence": {"type": "boolean"},
        "raw_response_status": {"enum": ["generated", "not_generated"]},
        "raw_response_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "raw_response_overall_support": {
          "oneOf": [{"$ref": "#/$defs/support"}, {"type": "null"}]
        },
        "raw_claims": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/claim"}},
        "final_response_overall_support": {"$ref": "#/$defs/support"},
        "final_claims": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/claim"}}
      },
      "allOf": [
        {
          "if": {"properties": {"raw_response_status": {"const": "generated"}}, "required": ["raw_response_status"]},
          "then": {
            "properties": {
              "raw_response_sha256": {"$ref": "#/$defs/sha256"},
              "raw_response_overall_support": {"$ref": "#/$defs/support"}
            }
          }
        },
        {
          "if": {"properties": {"raw_response_status": {"const": "not_generated"}}, "required": ["raw_response_status"]},
          "then": {
            "properties": {
              "raw_response_sha256": {"type": "null"},
              "raw_response_overall_support": {"type": "null"},
              "raw_claims": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
